# DeepSeek API key — get one at https://platform.deepseek.com/
# Copy this file to .env and fill in your key:
#   cp .env.example .env
DEEPSEEK_API_KEY=your_key_here

# Optional: enable thinking mode (chain-of-thought reasoning before tool calls).
# Slower and more expensive, but more deliberate on complex tasks.
# DEEPSEEK_THINKING=1

# Optional: reasoning effort when thinking mode is on (low, medium, high, max).
# Default: high. Note: low and medium are both mapped to high by DeepSeek.
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_MODEL=deepseek-v4-pro    # for more capable (slower, pricier)